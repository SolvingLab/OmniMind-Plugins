    "env": "ELEVENLABS_API_KEY",
    "modelId": "eleven_text_to_sound_v2",
    "requestBody": {
      "text": "required string; description of the sound, not a script to read aloud",
      "duration_seconds": "optional number, official bounds 0.5 to 30",
      "prompt_influence": "optional number, official bounds 0 to 1, server default 0.3",
      "loop": "optional boolean, official default false",
      "model_id": "eleven_text_to_sound_v2"
    },
    "success": "HTTP 200 audio payload, documented as an MP3 file"
  },
